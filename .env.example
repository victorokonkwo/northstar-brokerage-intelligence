# Template for the local-only .env file. Do not edit .env.example with real values.
# `make env` copies this file to .env (which is git-ignored) and replaces
# every <generate> or <generate-fernet-key> value with a fresh random secret.
# It never overwrites an existing .env.

# Warehouse Postgres (also read by the dbt profile, warehouse/dbt/profiles.yml.example)
NBI_PG_HOST=localhost
NBI_PG_PORT=5432
NBI_PG_DATABASE=northstar
NBI_PG_USER=northstar
NBI_PG_PASSWORD=<generate>

# S3-compatible object store (SeaweedFS); bucket northstar-data-local is created on start
NBI_S3_PORT=8333
NBI_S3_ENDPOINT_URL=http://localhost:8333
NBI_S3_ACCESS_KEY_ID=<generate>
NBI_S3_SECRET_ACCESS_KEY=<generate>

# Airflow (UI at http://localhost:8080)
AIRFLOW_UI_PORT=8080
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=<generate>
AIRFLOW_DB_PASSWORD=<generate>
AIRFLOW_JWT_SECRET=<generate>
AIRFLOW_FERNET_KEY=<generate-fernet-key>
