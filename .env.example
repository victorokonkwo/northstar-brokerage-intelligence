# Template for the local-only .env file. Do not edit .env.example with real values.
# `make env` copies this file to .env (which is git-ignored) and replaces
# every <generate> or <generate-fernet-key> value with a fresh random secret.
# It never overwrites an existing .env.

# Warehouse Postgres (also read by the dbt profile, warehouse/dbt/profiles.yml.example)
NBI_PG_HOST=localhost
NBI_PG_PORT=5432
NBI_PG_DATABASE=northstar
NBI_PG_USER=northstar
NBI_PG_PASSWORD=<generate>

# S3-compatible object store (SeaweedFS); bucket northstar-data-local is created on start
NBI_S3_PORT=8333
NBI_S3_ENDPOINT_URL=http://localhost:8333
NBI_S3_ACCESS_KEY_ID=<generate>
NBI_S3_SECRET_ACCESS_KEY=<generate>

# OpenTelemetry: the local Collector from `make up` (ADR 008). Remove the
# endpoint to record telemetry without exporting it.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_COLLECTOR_HEALTH_PORT=13133
NBI_ENVIRONMENT=local

# Terraform bootstrap (infrastructure/terraform/bootstrap/README.md): the
# budget alert address. Personal data, so it lives only in the git-ignored .env.
TF_VAR_budget_alert_email=
# Redshift (`--warehouse redshift`, the redshift dbt target): nothing to set here.
# The endpoint, bucket, and admin secret ARN are read from `terraform output` at run
# time (scripts/redshift_env.py), and credentials are temporary IAM ones (`aws login`).

# Terraform data stack (infrastructure/terraform/data/README.md): your public
# IPv4 as a JSON list, e.g. ["203.0.113.7/32"]. With Looker Studio, the only
# address allowed to reach Redshift. Personal data, so .env only.
TF_VAR_operator_cidrs=

# The read-only database user Looker Studio connects as (roadmap 4H, ADR 011).
# `make env` generates it; `northstar redshift-bootstrap --looker-user` sets it on
# Redshift, and you enter it in Looker Studio. Never stored in AWS or Git.
NBI_LOOKER_PASSWORD=<generate-redshift-password>

# Airflow (UI at http://localhost:8080)
AIRFLOW_UI_PORT=8080
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=<generate>
AIRFLOW_DB_PASSWORD=<generate>
AIRFLOW_JWT_SECRET=<generate>
AIRFLOW_FERNET_KEY=<generate-fernet-key>
