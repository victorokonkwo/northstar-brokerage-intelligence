{
  "$defs": {
    "Currency": {
      "description": "Currencies the platform books in (domain model \u00a76).\n\nMinor units come from the ISO 4217 list published by SIX Group\n(see docs/sources.md).",
      "enum": [
        "CAD",
        "USD"
      ],
      "title": "Currency",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The clearing firm's fee charged for one execution (matched to GL 5100).",
  "properties": {
    "account_id": {
      "title": "Account Id",
      "type": "string"
    },
    "amount": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "decimal_places": 2,
      "ge": 0,
      "max_digits": 18,
      "title": "Amount"
    },
    "broker_reference": {
      "title": "Broker Reference",
      "type": "string"
    },
    "currency": {
      "$ref": "#/$defs/Currency"
    },
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "record_type": {
      "const": "fee_record",
      "default": "fee_record",
      "title": "Record Type",
      "type": "string"
    },
    "trade_date": {
      "format": "date",
      "title": "Trade Date",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "broker_reference",
    "account_id",
    "trade_date",
    "currency",
    "amount"
  ],
  "title": "FeeRecord",
  "type": "object"
}
