{
  "$defs": {
    "Currency": {
      "description": "Currencies the platform books in (domain model \u00a76).\n\nMinor units come from the ISO 4217 list published by SIX Group\n(see docs/sources.md).",
      "enum": [
        "CAD",
        "USD"
      ],
      "title": "Currency",
      "type": "string"
    },
    "Side": {
      "description": "Order and trade direction. Long only: a SELL reduces an existing holding.",
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "Side",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The depository's confirmation that an obligation settled.",
  "properties": {
    "account_id": {
      "title": "Account Id",
      "type": "string"
    },
    "actual_settlement_date": {
      "format": "date",
      "title": "Actual Settlement Date",
      "type": "string"
    },
    "amount": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "decimal_places": 2,
      "gt": 0,
      "max_digits": 18,
      "title": "Amount"
    },
    "broker_reference": {
      "title": "Broker Reference",
      "type": "string"
    },
    "contractual_settlement_date": {
      "format": "date",
      "title": "Contractual Settlement Date",
      "type": "string"
    },
    "currency": {
      "$ref": "#/$defs/Currency"
    },
    "instrument_id": {
      "title": "Instrument Id",
      "type": "string"
    },
    "quantity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "decimal_places": 8,
      "gt": 0,
      "max_digits": 18,
      "title": "Quantity"
    },
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "record_type": {
      "const": "settlement_confirmation",
      "default": "settlement_confirmation",
      "title": "Record Type",
      "type": "string"
    },
    "side": {
      "$ref": "#/$defs/Side"
    }
  },
  "required": [
    "record_id",
    "broker_reference",
    "account_id",
    "instrument_id",
    "side",
    "quantity",
    "amount",
    "currency",
    "contractual_settlement_date",
    "actual_settlement_date"
  ],
  "title": "SettlementConfirmation",
  "type": "object"
}
