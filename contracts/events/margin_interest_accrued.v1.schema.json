{
  "$defs": {
    "Currency": {
      "description": "Currencies the platform books in (domain model \u00a76).\n\nMinor units come from the ISO 4217 list published by SIX Group\n(see docs/sources.md).",
      "enum": [
        "CAD",
        "USD"
      ],
      "title": "Currency",
      "type": "string"
    },
    "MarginInterestAccruedPayload": {
      "additionalProperties": false,
      "description": "One day of interest on a client's debit (margin loan) balance in one currency.",
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "accrual_date": {
          "format": "date",
          "title": "Accrual Date",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 2,
          "gt": 0,
          "max_digits": 18,
          "title": "Amount"
        },
        "annual_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 10,
          "gt": 0,
          "max_digits": 18,
          "title": "Annual Rate"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "day_count": {
          "const": "ACT/365",
          "title": "Day Count",
          "type": "string"
        },
        "debit_balance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 2,
          "gt": 0,
          "max_digits": 18,
          "title": "Debit Balance"
        },
        "margin_policy_version": {
          "title": "Margin Policy Version",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "accrual_date",
        "currency",
        "debit_balance",
        "annual_rate",
        "day_count",
        "amount",
        "margin_policy_version"
      ],
      "title": "MarginInterestAccruedPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``margin_interest_accrued`` event.",
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_timestamp": {
      "format": "date-time",
      "title": "Event Timestamp",
      "type": "string"
    },
    "event_type": {
      "const": "margin_interest_accrued",
      "default": "margin_interest_accrued",
      "title": "Event Type",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/MarginInterestAccruedPayload"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_system": {
      "const": "brokerage_simulator",
      "default": "brokerage_simulator",
      "title": "Source System",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_timestamp",
    "recorded_at",
    "correlation_id",
    "payload"
  ],
  "title": "MarginInterestAccrued",
  "type": "object"
}
