{
  "$defs": {
    "Currency": {
      "description": "Currencies the platform books in (domain model \u00a76).\n\nMinor units come from the ISO 4217 list published by SIX Group\n(see docs/sources.md).",
      "enum": [
        "CAD",
        "USD"
      ],
      "title": "Currency",
      "type": "string"
    },
    "OrderPlacedPayload": {
      "additionalProperties": false,
      "description": "A client order was accepted.\n\nRaises:\n    pydantic.ValidationError: A LIMIT order has no limit price, or a\n        MARKET order has one.",
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "limit_price": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "decimal_places": 8,
              "gt": 0,
              "max_digits": 18
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Price"
        },
        "market": {
          "title": "Market",
          "type": "string"
        },
        "order_id": {
          "title": "Order Id",
          "type": "string"
        },
        "order_type": {
          "$ref": "#/$defs/OrderType"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 8,
          "gt": 0,
          "max_digits": 18,
          "title": "Quantity"
        },
        "side": {
          "$ref": "#/$defs/Side"
        }
      },
      "required": [
        "order_id",
        "account_id",
        "instrument_id",
        "market",
        "side",
        "order_type",
        "quantity",
        "currency"
      ],
      "title": "OrderPlacedPayload",
      "type": "object"
    },
    "OrderType": {
      "description": "Order types.",
      "enum": [
        "MARKET",
        "LIMIT"
      ],
      "title": "OrderType",
      "type": "string"
    },
    "Side": {
      "description": "Order and trade direction. Long only: a SELL reduces an existing holding.",
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "Side",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "``order_placed`` event.",
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_timestamp": {
      "format": "date-time",
      "title": "Event Timestamp",
      "type": "string"
    },
    "event_type": {
      "const": "order_placed",
      "default": "order_placed",
      "title": "Event Type",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/OrderPlacedPayload"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_system": {
      "const": "brokerage_simulator",
      "default": "brokerage_simulator",
      "title": "Source System",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_timestamp",
    "recorded_at",
    "correlation_id",
    "payload"
  ],
  "title": "OrderPlaced",
  "type": "object"
}
