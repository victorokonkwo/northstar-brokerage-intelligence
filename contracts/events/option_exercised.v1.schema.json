{
  "$defs": {
    "Currency": {
      "description": "Currencies the platform books in (domain model \u00a76).\n\nMinor units come from the ISO 4217 list published by SIX Group\n(see docs/sources.md).",
      "enum": [
        "CAD",
        "USD"
      ],
      "title": "Currency",
      "type": "string"
    },
    "ExerciseReason": {
      "description": "Why a long option was exercised (roadmap 5C-b, ADR 013).",
      "enum": [
        "EARLY",
        "EXPIRY"
      ],
      "title": "ExerciseReason",
      "type": "string"
    },
    "OptionExercisedPayload": {
      "additionalProperties": false,
      "description": "A long option exercised (roadmap 5C-b, ADR 013).\n\nThe contracts leave, and the underlying is bought (a call) or sold (a put)\nat the strike, settling one business day later.\n\n``underlying_close`` is the close the expiry decision used (``EXPIRY`` only),\nand ``expiry_policy_version`` the policy that made it.\n\nRaises:\n    pydantic.ValidationError: The shares, the strike amount, or the dates\n        don't follow from the terms, or an expiry exercise lacks its close.",
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "contracts": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 8,
          "gt": 0,
          "max_digits": 18,
          "title": "Contracts"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "exercise_date": {
          "format": "date",
          "title": "Exercise Date",
          "type": "string"
        },
        "exercise_id": {
          "title": "Exercise Id",
          "type": "string"
        },
        "expiry_policy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expiry Policy Version"
        },
        "multiplier": {
          "minimum": 1,
          "title": "Multiplier",
          "type": "integer"
        },
        "option_instrument_id": {
          "title": "Option Instrument Id",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/ExerciseReason"
        },
        "right": {
          "$ref": "#/$defs/OptionRight"
        },
        "settlement_date": {
          "format": "date",
          "title": "Settlement Date",
          "type": "string"
        },
        "settlement_id": {
          "title": "Settlement Id",
          "type": "string"
        },
        "shares": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 8,
          "gt": 0,
          "max_digits": 18,
          "title": "Shares"
        },
        "strike": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 8,
          "gt": 0,
          "max_digits": 18,
          "title": "Strike"
        },
        "strike_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 2,
          "gt": 0,
          "max_digits": 18,
          "title": "Strike Amount"
        },
        "underlying_close": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "decimal_places": 8,
              "gt": 0,
              "max_digits": 18
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Underlying Close"
        },
        "underlying_instrument_id": {
          "title": "Underlying Instrument Id",
          "type": "string"
        }
      },
      "required": [
        "exercise_id",
        "settlement_id",
        "account_id",
        "option_instrument_id",
        "underlying_instrument_id",
        "right",
        "contracts",
        "multiplier",
        "shares",
        "strike",
        "strike_amount",
        "currency",
        "exercise_date",
        "settlement_date",
        "reason"
      ],
      "title": "OptionExercisedPayload",
      "type": "object"
    },
    "OptionRight": {
      "description": "Call or put.",
      "enum": [
        "CALL",
        "PUT"
      ],
      "title": "OptionRight",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "``option_exercised`` event.",
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_timestamp": {
      "format": "date-time",
      "title": "Event Timestamp",
      "type": "string"
    },
    "event_type": {
      "const": "option_exercised",
      "default": "option_exercised",
      "title": "Event Type",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/OptionExercisedPayload"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_system": {
      "const": "brokerage_simulator",
      "default": "brokerage_simulator",
      "title": "Source System",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_timestamp",
    "recorded_at",
    "correlation_id",
    "payload"
  ],
  "title": "OptionExercised",
  "type": "object"
}
