{
  "$defs": {
    "AssetClass": {
      "description": "Asset classes with their own settlement cycles.",
      "enum": [
        "EQUITY",
        "OPTION"
      ],
      "title": "AssetClass",
      "type": "string"
    },
    "Currency": {
      "description": "Currencies the platform books in (domain model \u00a76).\n\nMinor units come from the ISO 4217 list published by SIX Group\n(see docs/sources.md).",
      "enum": [
        "CAD",
        "USD"
      ],
      "title": "Currency",
      "type": "string"
    },
    "PolicyVersions": {
      "additionalProperties": false,
      "description": "Versions of the policies a source system applied to produce an event (W2).",
      "properties": {
        "calendar": {
          "title": "Calendar",
          "type": "string"
        },
        "fee_schedule": {
          "title": "Fee Schedule",
          "type": "string"
        },
        "settlement_rules": {
          "title": "Settlement Rules",
          "type": "string"
        }
      },
      "required": [
        "calendar",
        "settlement_rules",
        "fee_schedule"
      ],
      "title": "PolicyVersions",
      "type": "object"
    },
    "Side": {
      "description": "Order and trade direction. Long only: a SELL reduces an existing holding.",
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "Side",
      "type": "string"
    },
    "TradeExecutedPayload": {
      "additionalProperties": false,
      "description": "One fill of an order, with the commission charged for it (per execution, OQ-02).",
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "asset_class": {
          "$ref": "#/$defs/AssetClass"
        },
        "commission": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 2,
          "ge": 0,
          "max_digits": 18,
          "title": "Commission"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "execution_id": {
          "title": "Execution Id",
          "type": "string"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "market": {
          "title": "Market",
          "type": "string"
        },
        "multiplier": {
          "minimum": 1,
          "title": "Multiplier",
          "type": "integer"
        },
        "order_id": {
          "title": "Order Id",
          "type": "string"
        },
        "policy_versions": {
          "$ref": "#/$defs/PolicyVersions"
        },
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 8,
          "gt": 0,
          "max_digits": 18,
          "title": "Price"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 8,
          "gt": 0,
          "max_digits": 18,
          "title": "Quantity"
        },
        "settlement_date": {
          "format": "date",
          "title": "Settlement Date",
          "type": "string"
        },
        "settlement_id": {
          "title": "Settlement Id",
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "trade_date": {
          "format": "date",
          "title": "Trade Date",
          "type": "string"
        }
      },
      "required": [
        "execution_id",
        "order_id",
        "account_id",
        "instrument_id",
        "market",
        "asset_class",
        "side",
        "quantity",
        "price",
        "multiplier",
        "currency",
        "commission",
        "trade_date",
        "settlement_date",
        "settlement_id",
        "policy_versions"
      ],
      "title": "TradeExecutedPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``trade_executed`` event.",
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_timestamp": {
      "format": "date-time",
      "title": "Event Timestamp",
      "type": "string"
    },
    "event_type": {
      "const": "trade_executed",
      "default": "trade_executed",
      "title": "Event Type",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/TradeExecutedPayload"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_system": {
      "const": "brokerage_simulator",
      "default": "brokerage_simulator",
      "title": "Source System",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_timestamp",
    "recorded_at",
    "correlation_id",
    "payload"
  ],
  "title": "TradeExecuted",
  "type": "object"
}
