{
  "$defs": {
    "Currency": {
      "description": "Currencies the platform books in (domain model \u00a76).\n\nMinor units come from the ISO 4217 list published by SIX Group\n(see docs/sources.md).",
      "enum": [
        "CAD",
        "USD"
      ],
      "title": "Currency",
      "type": "string"
    },
    "DividendDeclaredPayload": {
      "additionalProperties": false,
      "description": "An issuer's cash dividend declaration (roadmap 5C-a, ADR 013).\n\nUnder T+1 the ex-dividend date is the record date (FINRA Rule 11140; TSX\nOps Notice 2024-015), so both are carried and must be equal. The rate is\nper share in whole cents, so every allocation is exact. That the record\ndate is a business day is checked against the calendar by the brokerage.\n\nRaises:\n    pydantic.ValidationError: The dates are out of order, the ex-date isn't\n        the record date, or the rate isn't whole cents.",
      "properties": {
        "amount_per_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 8,
          "gt": 0,
          "max_digits": 18,
          "title": "Amount Per Share"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "declaration_date": {
          "format": "date",
          "title": "Declaration Date",
          "type": "string"
        },
        "dividend_id": {
          "title": "Dividend Id",
          "type": "string"
        },
        "ex_date": {
          "format": "date",
          "title": "Ex Date",
          "type": "string"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "pay_date": {
          "format": "date",
          "title": "Pay Date",
          "type": "string"
        },
        "record_date": {
          "format": "date",
          "title": "Record Date",
          "type": "string"
        }
      },
      "required": [
        "dividend_id",
        "instrument_id",
        "currency",
        "amount_per_share",
        "declaration_date",
        "ex_date",
        "record_date",
        "pay_date"
      ],
      "title": "DividendDeclaredPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``dividend_declared`` event.",
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_timestamp": {
      "format": "date-time",
      "title": "Event Timestamp",
      "type": "string"
    },
    "event_type": {
      "const": "dividend_declared",
      "default": "dividend_declared",
      "title": "Event Type",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/DividendDeclaredPayload"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_system": {
      "const": "brokerage_simulator",
      "default": "brokerage_simulator",
      "title": "Source System",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_timestamp",
    "recorded_at",
    "correlation_id",
    "payload"
  ],
  "title": "DividendDeclared",
  "type": "object"
}
